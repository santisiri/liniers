# Proveedores de generación por NIVEL (ver pipeline/providers.json).
# El MCP conectado cubre los tres niveles por defecto; estas claves los reemplazan
# cuando el director las entregue.

# Nivel 1 — mejor generador de imágenes (hojas de personaje, key frames)
IMAGE_HERO_API_KEY=
IMAGE_HERO_PROVIDER=           # ej: fal, replicate, openai, bfl
IMAGE_HERO_MODEL=

# Nivel 2 — video boceto barato (animatics, pre-visualización)
VIDEO_DRAFT_API_KEY=
VIDEO_DRAFT_PROVIDER=
VIDEO_DRAFT_MODEL=

# Nivel 3 — render final de la película (shots aprobados)
VIDEO_FINAL_API_KEY=
VIDEO_FINAL_PROVIDER=
VIDEO_FINAL_MODEL=

# Raíz del proyecto para el dashboard (por defecto: el directorio padre de dashboard/)
LINIERS_ROOT=
